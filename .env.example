# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit real keys.
#
# Both values come from the Supabase dashboard:
#   Project Settings > API
#
# These are NEXT_PUBLIC_ and get inlined into the browser bundle. That is fine:
# the anon key is a public identifier, not a secret. Row Level Security is what
# protects the data, which is why the policies in supabase/migrations matter so
# much.
#
# Do NOT add the service_role key here. It bypasses RLS entirely.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
